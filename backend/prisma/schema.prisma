// ============================================================
// INCIDENT REPORT SYSTEM - Transactional Data
// ============================================================

// Incident - Transactional Data
model Incident {
  id                       String                     @id @default(uuid())
  code                     String                     @unique
  subject                  String
  incidentDate             DateTime
  roomId                   String?
  areaId                   String
  incidentType             IncidentTypeEnum
  incidentClassification   IncidentClassificationEnum
  activities               IncidentActivitiesEnum     @default(WORK)
  type                     IncidentScopeEnum          @default(GENERAL)
  requesterId              String
  reportedBy               String
  technicianId             String?
  priority                 PriorityEnum               @default(NORMAL)
  riskCategoryId           String
  description              String?                    @db.Text
  controlMeasure           String?                    @db.Text
  dueDate                  DateTime?
  expectedOutcome          String?                    @db.Text
  needToStopActivity       StopActivityEnum           @default(NOT_SPECIFIED)
  /// @deprecated Use stopLocally and stopWholeSchool booleans instead. Retained for backward compatibility until frontend migration completes.
  stopActivityDescription  String?                    @db.Text
  stopLocally              Boolean                    @default(false)
  stopWholeSchool          Boolean                    @default(false)
  treatment                TreatmentEnum              @default(NOT_SPECIFIED)
  treatmentDescription     String?                    @db.Text
  absence                  AbsenceEnum                @default(NOT_SPECIFIED)
  resolution               String?                    @db.Text
  needFurtherInvestigation Boolean                    @default(false)
  assignedDepartmentId     String
  assigneeId               String?
  status                   GeneralStatusEnum
  source                   SourceEnum                 @default(SYSTEM)
  isActive                 Boolean                    @default(true)
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  createdBy                String

  // Relations
  room                Room?                   @relation(fields: [roomId], references: [id])
  area                Area                    @relation(fields: [areaId], references: [id])
  riskCategory        RiskCategory            @relation(fields: [riskCategoryId], references: [id])
  requester           User                    @relation("IncidentRequester", fields: [requesterId], references: [id])
  reporter            User                    @relation("IncidentReporter", fields: [reportedBy], references: [id])
  technician          User?                   @relation("IncidentTechnician", fields: [technicianId], references: [id])
  assignedDepartment  Department              @relation(fields: [assignedDepartmentId], references: [id])
  assignee            User?                   @relation("IncidentAssignee", fields: [assigneeId], references: [id])
  creator             User                    @relation("IncidentCreator", fields: [createdBy], references: [id])
  injuredPersons      IncidentInjuredPerson[]
  witnesses           IncidentWitness[]
  assets              IncidentAsset[]
  images              IncidentImage[]
  attachments         IncidentAttachment[]
  investigationReport InvestigationReport?

  @@index([code])
  @@index([roomId])
  @@index([areaId])
  @@index([riskCategoryId])
  @@index([requesterId])
  @@index([reportedBy])
  @@index([assignedDepartmentId])
  @@index([assigneeId])
  @@index([status])
  @@index([source])
  @@index([activities])
  @@index([type])
  @@map("t_incidents")
}

// Incident Injured Person - Transactional Data
model IncidentInjuredPerson {
  id                String                @id @default(uuid())
  incidentId        String
  injuredPersonName String?
  gender            GenderEnum?
  levelOfInjury     LevelOfInjuryEnum     @default(NOT_SPECIFIED)
  injuredBodyPart   InjuredBodyPartEnum   @default(NOT_SPECIFIED)
  typeOfInjury      TypeOfInjuryEnum      @default(NOT_SPECIFIED)
  mechanismOfInjury MechanismOfInjuryEnum @default(NOT_SPECIFIED)
  position          String?               @db.VarChar(255)
  departmentId      String?
  order             Int
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  // Relations
  incident   Incident    @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  department Department? @relation("IncidentInjuredPersonDepartment", fields: [departmentId], references: [id])

  @@index([incidentId])
  @@index([departmentId])
  @@map("t_incident_injured_persons")
}

// Incident Witness - Transactional Data
model IncidentWitness {
  id           String      @id @default(uuid())
  incidentId   String
  witnessName  String?
  gender       GenderEnum?
  position     String?     @db.VarChar(255)
  departmentId String?
  order        Int
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  // Relations
  incident   Incident    @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  department Department? @relation("IncidentWitnessDepartment", fields: [departmentId], references: [id])

  @@index([incidentId])
  @@index([departmentId])
  @@map("t_incident_witnesses")
}

// Incident Asset - Transactional Data (Polymorphic)
// Supports ASSET, HEAVY_EQUIPMENT, and SAFETY_EQUIPMENT entity types
// Can reference m_assets (entity='ASSET'), m_heavy_equipment (entity='HEAVY_EQUIPMENT'), or m_safety_equipment (entity='SAFETY_EQUIPMENT')
// Free-text fallback: If entity is null, assetName and assetCode are used
model IncidentAsset {
  id         String               @id @default(uuid())
  incidentId String
  // Polymorphic reference
  entity     EquipmentEntityEnum? // Entity type identifier (ASSET, HEAVY_EQUIPMENT, SAFETY_EQUIPMENT)
  entityId   String? // Entity ID - references m_assets.id, m_heavy_equipment.id, or m_safety_equipment.id
  // Free-text fields (used when entity is null or as fallback)
  assetName  String
  assetCode  String?
  quantity   Int? // Quantity of the asset
  order      Int
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  // Relations
  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  // Note: Polymorphic relations (asset, heavyEquipment, safetyEquipment) are handled manually in application code
  // Prisma doesn't support multiple foreign keys on the same field, so we load these relations manually

  @@index([incidentId])
  @@index([entity, entityId])
  @@map("t_incident_assets")
}

// Incident Image - Transactional Data
model IncidentImage {
  id         String   @id @default(uuid())
  incidentId String
  imageUrl   String
  caption    String?  @db.Text
  order      Int
  createdAt  DateTime @default(now())

  // Relations
  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
  @@index([order])
  @@map("t_incident_images")
}

// Incident Attachment - Transactional Data
model IncidentAttachment {
  id            String   @id @default(uuid())
  incidentId    String
  attachmentUrl String
  order         Int
  createdAt     DateTime @default(now())

  // Relations
  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
  @@index([order])
  @@map("t_incident_attachments")
}

// ============================================================
// AUDIT SYSTEM - Master Data
// ============================================================

// Audit Element - Master Data
model AuditElement {
  id          String    @id @default(uuid())
  name        String
  code        String
  description String?   @db.Text
  isActive    Boolean   @default(true)
  deletedAt   DateTime?
  deletedBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  clauses AuditClause[]
  audits  Audit[]

  @@index([code])
  @@map("m_audit_element")
}

// Audit Clause - Master Data
model AuditClause {
  id             String    @id @default(uuid())
  name           String
  code           String
  description    String?   @db.Text
  auditElementId String
  order          Int
  isActive       Boolean   @default(true)
  deletedAt      DateTime?
  deletedBy      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relations
  auditElement AuditElement    @relation(fields: [auditElementId], references: [id])
  criteria     AuditCriteria[]

  @@index([code])
  @@index([auditElementId])
  @@index([order])
  @@map("m_audit_clause")
}

// Audit Criteria - Master Data
model AuditCriteria {
  id             String             @id @default(uuid())
  name           String
  code           String
  description    String?            @db.Text
  auditClauseId  String
  transitionType TransitionTypeEnum
  order          Int
  isActive       Boolean            @default(true)
  deletedAt      DateTime?
  deletedBy      String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  // Relations
  auditClause AuditClause @relation(fields: [auditClauseId], references: [id])
  auditItems  AuditItem[]

  @@index([code])
  @@index([auditClauseId])
  @@index([order])
  @@map("m_audit_criteria")
}

// ============================================================
// AUDIT SYSTEM - Transactional Data
// ============================================================

enum CompliantStatusEnum {
  COMPLY
  NOT_COMPLY_MAJOR
  NOT_COMPLY_MINOR
}

// Audit Period - Transactional Data
// Groups multiple audits (one per active AuditElement) into a month/year period.
// Uniqueness of (month, year) is enforced at service level among non-deleted rows.
model AuditPeriod {
  id        String    @id @default(uuid())
  month     Int // 1–12
  year      Int // e.g. 2026
  notes     String?   @db.Text
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String
  deletedAt DateTime?
  deletedBy String?

  creator User    @relation("AuditPeriodCreator", fields: [createdBy], references: [id])
  audits  Audit[]

  @@index([year, month])
  @@map("t_audit_periods")
}

// Audit - Transactional Data
model Audit {
  id             String            @id @default(uuid())
  code           String            @unique
  auditDate      DateTime
  auditElementId String
  periodId       String? // nullable for backward-compat with pre-period rows
  status         GeneralStatusEnum
  isActive       Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  createdBy      String

  // Relations
  areas        AuditToArea[]
  auditElement AuditElement  @relation(fields: [auditElementId], references: [id])
  creator      User          @relation("AuditCreator", fields: [createdBy], references: [id])
  items        AuditItem[]
  auditors     AuditToUser[]
  period       AuditPeriod?  @relation(fields: [periodId], references: [id])

  @@index([auditElementId])
  @@index([status])
  @@index([periodId])
  @@map("t_audits")
}

// Audit Item - Transactional Data
model AuditItem {
  id                String              @id @default(uuid())
  auditId           String
  auditCriteriaId   String
  status            GeneralStatusEnum   @default(OPEN)
  compliantStatus   CompliantStatusEnum
  evidence          String?             @db.Text
  recommendation    String?             @db.Text
  actionRealization String?             @db.Text
  order             Int
  dueDate           DateTime
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  // Relations
  audit         Audit                   @relation(fields: [auditId], references: [id], onDelete: Cascade)
  auditCriteria AuditCriteria           @relation(fields: [auditCriteriaId], references: [id])
  departments   AuditItemToDepartment[]
  users         AuditItemToUser[]
  images        AuditImage[]

  @@index([auditId])
  @@index([auditCriteriaId])
  @@index([status])
  @@map("t_audit_items")
}

// Audit Image - Transactional Data
model AuditImage {
  id          String   @id @default(uuid())
  auditItemId String
  imageUrl    String
  caption     String?  @db.Text
  order       Int
  createdAt   DateTime @default(now())

  // Relations
  auditItem AuditItem @relation(fields: [auditItemId], references: [id], onDelete: Cascade)

  @@index([auditItemId])
  @@index([order])
  @@map("t_audit_images")
}

// Audit Item to Department - Many-to-Many Junction Table
model AuditItemToDepartment {
  id           String   @id @default(uuid())
  auditItemId  String
  departmentId String
  createdAt    DateTime @default(now())

  // Relations
  auditItem  AuditItem  @relation(fields: [auditItemId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id])

  @@unique([auditItemId, departmentId])
  @@index([auditItemId])
  @@index([departmentId])
  @@map("_AuditItemToDepartment")
}

// Audit Item to User - Many-to-Many Junction Table (optional users)
model AuditItemToUser {
  id          String   @id @default(uuid())
  auditItemId String
  userId      String
  createdAt   DateTime @default(now())

  // Relations
  auditItem AuditItem @relation(fields: [auditItemId], references: [id], onDelete: Cascade)
  user      User      @relation("AuditItemAssignee", fields: [userId], references: [id])

  @@unique([auditItemId, userId])
  @@index([auditItemId])
  @@index([userId])
  @@map("_AuditItemToUser")
}

// Audit to Area - Many-to-Many Junction Table
model AuditToArea {
  id        String   @id @default(uuid())
  auditId   String
  areaId    String
  createdAt DateTime @default(now())

  // Relations
  audit Audit @relation(fields: [auditId], references: [id], onDelete: Cascade)
  area  Area  @relation(fields: [areaId], references: [id])

  @@unique([auditId, areaId])
  @@index([auditId])
  @@index([areaId])
  @@map("_AuditToArea")
}

// Audit to User - Many-to-Many Junction Table (auditors)
model AuditToUser {
  id        String   @id @default(uuid())
  auditId   String
  userId    String
  createdAt DateTime @default(now())

  // Relations
  audit Audit @relation(fields: [auditId], references: [id], onDelete: Cascade)
  user  User  @relation("AuditAuditor", fields: [userId], references: [id])

  @@unique([auditId, userId])
  @@index([auditId])
  @@index([userId])
  @@map("_AuditToUser")
}

// ============================================================
// WASTEWATER MANAGEMENT - Master Data
