  chapterId      String
  status         String    @default("NOT_STARTED") // NOT_STARTED, IN_PROGRESS, COMPLETED
  timeSpent      Int       @default(0) // in seconds
  progress       Decimal   @default(0) @db.Decimal(5, 2) // 0.00 to 100.00
  startedAt      DateTime?
  completedAt    DateTime?
  lastAccessedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relations
  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  chapter    Chapter    @relation(fields: [chapterId], references: [id])

  @@unique([enrollmentId, chapterId])
  @@map("t_progress")
}

// Quiz System Enums
enum QuizEntityEnum {
  COURSE
  CHAPTER
}

/// Distinguishes LMS quizzes from health declaration questionnaires (no grading expectation for health).
enum QuizKindEnum {
  LMS_QUIZ
  HEALTH_DECLARATION
}

/// IN_PROGRESS = filling not finalized. DONE = submitted. EXPIRED = scheduler when createdAt is outside validity window.
enum HealthScreeningStatusEnum {
  IN_PROGRESS
  DONE
  EXPIRED
}

enum QuizAttemptStatusEnum {
  INVITING
  INVITED
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

// Quiz - Transactional Data (LMS + health declaration questionnaires)
model Quiz {
  id                          String          @id @default(uuid())
  kind                        QuizKindEnum    @default(LMS_QUIZ)
  entity                      QuizEntityEnum? // COURSE, CHAPTER, or null (standalone)
  entityId                    String? // courseId or chapterId, or null
  title                       String
  description                 String?         @db.Text
  instructions                String?         @db.Text
  duration                    Int? // in minutes
  passingScore                Decimal         @default(75) @db.Decimal(5, 2) // 0.00 to 100.00
  maxAttempts                 Int? // null = unlimited
  shuffleQuestions            Boolean         @default(false)
  shuffleOptions              Boolean         @default(false)
  showCorrectAnswer           Boolean         @default(true)
  isPublished                 Boolean         @default(false)
  publishedAt                 DateTime?
  isActive                    Boolean         @default(true)
  /// Globally at most one quiz may be true; used when starting a health screening without quizId.
  isDefaultForHealthScreening Boolean         @default(false)
  createdBy                   String
  createdAt                   DateTime        @default(now())
  updatedAt                   DateTime        @updatedAt

  // Relations
  creator          User              @relation("QuizCreator", fields: [createdBy], references: [id])
  questions        QuizQuestion[]
  assignments      QuizAssignment[]
  attempts         QuizAttempt[]
  healthScreenings HealthScreening[]

  @@index([entity, entityId])
  @@index([kind])
  @@map("t_quizzes")
}

// Quiz Question - Transactional Data (LMS)
model QuizQuestion {
  id           String   @id @default(uuid())
  quizId       String
  questionType String // MULTIPLE_CHOICE, ESSAY, TRUE_FALSE
  questionText String   @db.Text
  explanation  String?  @db.Text
  mediaUrl     String?
  mediaType    String? // image, video, audio
  points       Decimal  @default(1) @db.Decimal(5, 2)
  order        Int
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  quiz    Quiz                 @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options QuizQuestionOption[]
  answers QuizAnswer[]

  @@map("t_quiz_questions")
}

// Quiz Question Option - Transactional Data (LMS)
model QuizQuestionOption {
  id         String   @id @default(uuid())
  questionId String
  optionText String   @db.Text
  isCorrect  Boolean  @default(false)
  order      Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  question QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers  QuizAnswer[]

  @@map("t_quiz_question_options")
}

// Quiz Assignment - Transactional Data (LMS)
// Only used for standalone quizzes (entity IS NULL)
model QuizAssignment {
  id         String    @id @default(uuid())
  quizId     String
  userId     String
  assignedBy String
  assignedAt DateTime  @default(now())
  dueDate    DateTime?
  isRequired Boolean   @default(false)
  status     String    @default("PENDING") // PENDING, COMPLETED, EXPIRED
  notes      String?   @db.Text
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  // Relations
  quiz     Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user     User @relation("QuizAssignmentUser", fields: [userId], references: [id])
  assigner User @relation("QuizAssignmentAssigner", fields: [assignedBy], references: [id])

  @@unique([quizId, userId])
  @@index([userId])
  @@index([quizId])
  @@index([status])
  @@index([dueDate])
  @@map("t_quiz_assignments")
}

// Quiz Attempt - Transactional Data (LMS)
model QuizAttempt {
  id            String                @id @default(uuid())
  quizId        String
  enrollmentId  String? // For bound quizzes (COURSE/CHAPTER)
  userId        String? // For standalone quizzes
  attemptNumber Int
  status        QuizAttemptStatusEnum @default(IN_PROGRESS)
  score         Decimal?              @db.Decimal(5, 2) // 0.00 to 100.00
  totalPoints   Decimal?              @db.Decimal(10, 2)
  earnedPoints  Decimal?              @db.Decimal(10, 2)
  isPassed      Boolean               @default(false)
  dueDate       DateTime?
  startedAt     DateTime              @default(now())
  completedAt   DateTime?
  timeSpent     Int                   @default(0) // in seconds
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  // Relations
  quiz            Quiz             @relation(fields: [quizId], references: [id], onDelete: Cascade)
  enrollment      Enrollment?      @relation(fields: [enrollmentId], references: [id])
  user            User?            @relation("QuizAttemptUser", fields: [userId], references: [id])
  answers         QuizAnswer[]
  healthScreening HealthScreening?

  @@index([enrollmentId, quizId])
  @@index([userId, quizId])
  @@index([status])
  @@map("t_quiz_attempts")
}

// Quiz Answer - Transactional Data (LMS)
model QuizAnswer {
  id               String    @id @default(uuid())
  attemptId        String
  questionId       String
  selectedOptionId String? // For multiple choice/true-false
  essayAnswer      String?   @db.Text // For essay questions
  isCorrect        Boolean? // null for ungraded essays
  pointsEarned     Decimal   @default(0) @db.Decimal(5, 2)
  feedback         String?   @db.Text
  gradedBy         String?
  gradedAt         DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Relations
  attempt        QuizAttempt         @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question       QuizQuestion        @relation(fields: [questionId], references: [id])
  selectedOption QuizQuestionOption? @relation(fields: [selectedOptionId], references: [id])
  grader         User?               @relation("QuizAnswerGrader", fields: [gradedBy], references: [id])

  @@unique([attemptId, questionId])
  @@map("t_quiz_answers")
}

/// Structured health declaration submission linked to a quiz template and quiz attempt (answers).
model HealthScreening {
  id                         String                    @id @default(uuid())
  userId                     String
  companyId                  String?
  quizId                     String
  quizAttemptId              String                    @unique
  /// Links structured declaration to worker profile (not to a specific permit assignment).
  workerId                   String?
  status                     HealthScreeningStatusEnum @default(IN_PROGRESS)
  /// Set when the user submits with both declaration acknowledgements (audit).
  declarationTermsAcceptedAt DateTime?                 @map("declaration_terms_accepted_at")
  /// Single-use binding: when set, this declaration is consumed by that work permit and unavailable for others. Cleared when the permit is REJECTED to allow reuse on resubmission.
  consumedByWorkPermitId     String?                   @map("consumed_by_work_permit_id")
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt

  user                 User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  company              Company?    @relation(fields: [companyId], references: [id])
