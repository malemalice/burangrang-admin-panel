// INSPECTION SYSTEM
// ============================================================

// Inspection - Transactional Data
model Inspection {
  id             String                 @id @default(uuid())
  code           String                 @unique
  inspectionDate DateTime
  status         GeneralStatusEnum
  isActive       Boolean                @default(true)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  createdBy      String
  doneAt         DateTime?

  // Relations
  creator    User                   @relation("InspectionCreator", fields: [createdBy], references: [id])
  items      InspectionItem[]
  inspectors InspectionInspector[]
  areas      InspectionToArea[]

  @@index([status])
  @@map("t_inspections")
}

// Inspection Item - Transactional Data
// Has 1-to-1 polymorphic relation with RiskMitigationRecord (entity='INSPECTION_ITEM', entityId=id)
model InspectionItem {
  id                  String   @id @default(uuid())
  inspectionId        String
  areaId              String
  riskCategoryId      String
  riskId              String
  assignedDepartmentId String
  assigneeId          String?
  status              GeneralStatusEnum @default(OPEN)
  findings            String?  @db.Text
  description         String?  @db.Text
  followUpNotes       String?  @db.Text
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  dueDateAt           DateTime?

  // Relations
  inspection          Inspection     @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  area                Area           @relation(fields: [areaId], references: [id])
  riskCategory        RiskCategory   @relation(fields: [riskCategoryId], references: [id])
  risk                Risk           @relation(fields: [riskId], references: [id])
  assignedDepartment  Department     @relation(fields: [assignedDepartmentId], references: [id])
  assignee            User?          @relation("InspectionItemAssignee", fields: [assigneeId], references: [id])
  images              InspectionImage[]

  @@index([inspectionId])
  @@index([areaId])
  @@index([riskCategoryId])
  @@index([riskId])
  @@index([assignedDepartmentId])
  @@index([assigneeId])
  @@index([status])
  @@map("t_inspection_items")
}

// Inspection Image - Transactional Data
// Supports before/after fix action plan tracking
model InspectionImage {
  id               String                  @id @default(uuid())
  inspectionItemId String
  imageUrl         String
  caption          String?                 @db.Text
  type             InspectionImageTypeEnum @default(GENERAL) // BEFORE: before fix action plan, AFTER: after fix action plan, GENERAL: general inspection image
  order            Int
  createdAt        DateTime                 @default(now())

  // Relations
  inspectionItem InspectionItem @relation(fields: [inspectionItemId], references: [id], onDelete: Cascade)

  @@index([inspectionItemId])
  @@index([inspectionItemId, type])
  @@index([order])
  @@map("t_inspection_images")
}

// Inspection Inspector - Transactional Data
model InspectionInspector {
  id           String   @id @default(uuid())
  inspectionId String
  inspectorId  String
  order        Int
