generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Email Templates - Master Data
model EmailTemplate {
  id              String    @id @default(uuid())
  code            String // unique among non-deleted rows (partial index)
  name            String // Human readable name
  subjectTemplate String // Handlebars template for subject
  bodyTemplate    String    @db.Text // Handlebars template for HTML body
  isActive        Boolean   @default(true)
  deletedAt       DateTime?
  deletedBy       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([code])
  @@map("m_email_templates")
}

model User {
  id                                String                      @id @default(uuid())
  email                             String
  password                          String?
  firstName                         String
  lastName                          String
  isActive                          Boolean                     @default(true)
  roleId                            String
  officeId                          String
  departmentId                      String?
  jobPositionId                     String?
  companyId                         String?
  /// Default profession for contractor / work-permit workers (optional).
  professionId                      String?
  /// Worker ID number (e.g. national ID) for contractor profile; optional.
  idNumber                          String?
  createdAt                         DateTime                    @default(now())
  updatedAt                         DateTime                    @updatedAt
  lastLoginAt                       DateTime?
  deletedAt                         DateTime?
  deletedBy                         String?
  refreshTokens                     RefreshToken[]
  passwordResetTokens               PasswordResetToken[]
  office                            Office                      @relation(fields: [officeId], references: [id])
  company                           Company?                    @relation(fields: [companyId], references: [id])
  profession                        Profession?                 @relation(fields: [professionId], references: [id])
  role                              Role                        @relation(fields: [roleId], references: [id])
  department                        Department?                 @relation(fields: [departmentId], references: [id])
  jobPosition                       JobPosition?                @relation(fields: [jobPositionId], references: [id])
  riskAssessments                   RiskAssessment[]
  riskAssessmentsCreated            RiskAssessment[]            @relation("RiskAssessmentCreator")
  createdApprovalItems              MasterApprovalItem[]        @relation("CreatedApprovalItems")
  createdApprovals                  Approval[]                  @relation("CreatedApprovals")
  createdNotifications              Notification[]              @relation("NotificationCreator")
  notificationRecipients            NotificationRecipient[]     @relation("NotificationRecipient")
  uploadedFiles                     FileUpload[]
  fileAccessLogs                    FileAccessLog[]
  accessLogs                        AccessLog[]                 @relation("AccessLogUser")
  ppeStocksCreated                  PPEStock[]                  @relation("PPEStockCreator")
  ppeStockAdjustments               PPEStockAdjustment[]        @relation("PPEStockAdjuster")
  ppeExpiryAlerts                   PPEExpiryAlert[]            @relation("PPEExpiryAlertRecipient")
  ppeWithdrawalsRequested           PPEWithdrawal[]             @relation("PPEWithdrawalRequester")
  ppeWithdrawalsRequestedFor        PPEWithdrawal[]             @relation("PPEWithdrawalRequestedFor")
  ppeWithdrawalsCollected           PPEWithdrawal[]             @relation("PPEWithdrawalCollector")
  ppeWithdrawalsCreated             PPEWithdrawal[]             @relation("PPEWithdrawalCreator")
  instructorCourses                 Course[]                    @relation("CourseInstructor")
  enrollments                       Enrollment[]
  enrollmentsAssigned               Enrollment[]                @relation("EnrollmentAssigner")
  createdReminders                  Reminder[]                  @relation("CreatedReminders")
  quizzesCreated                    Quiz[]                      @relation("QuizCreator")
  quizAssignments                   QuizAssignment[]            @relation("QuizAssignmentUser")
  quizAssignmentsAssigned           QuizAssignment[]            @relation("QuizAssignmentAssigner")
  quizAttempts                      QuizAttempt[]               @relation("QuizAttemptUser")
  healthScreenings                  HealthScreening[]
  quizAnswersGraded                 QuizAnswer[]                @relation("QuizAnswerGrader")
  certificatesAsPersonnel           Certificate[]               @relation("CertificatePersonnel")
  certificatesCreated               Certificate[]               @relation("CertificateCreator")
  certificateRenewalsRequested      CertificateRenewal[]        @relation("CertificateRenewalRequester")
  certificateRenewalsProcessed      CertificateRenewal[]        @relation("CertificateRenewalProcessor")
  certificateReminders              CertificateReminder[]       @relation("CertificateReminderRecipient")
  workPermitsCreated                WorkPermit[]                @relation("WorkPermitCreator")
  /// Business applicant for work permits created on behalf.
  workPermitsApplied                WorkPermit[]                @relation("WorkPermitApplicant")
  workPermitEmployees               WorkPermitEmployee[]        @relation("WorkPermitEmployee")
  workPermitHseOfficers             WorkPermitToUser[]          @relation("WorkPermitHseOfficer")
  /// One-to-one worker profile (contractor / work-permit worker details).
  worker                            Worker?
  environmentalMeasurements         EnvironmentalMeasurement[]  @relation("EnvironmentalMeasurementCreator")
  inspectionsCreated                Inspection[]                @relation("InspectionCreator")
  inspectionItemsAssigned           InspectionItem[]            @relation("InspectionItemAssignee")
  inspectionInspectors              InspectionInspector[]       @relation("InspectionInspectorUser")
  inspectionChecklistResultsCreated InspectionChecklistResult[] @relation("InspectionChecklistResultCreator")

  // Waste Management Relations
  treatmentPlantsCreated          TreatmentPlant[]        @relation("TreatmentPlantCreator")
  monthlyFlowReportsSubmitted     MonthlyFlowReport[]     @relation("MonthlyFlowReportSubmitter")
  monthlyFlowReportsReceived      MonthlyFlowReport[]     @relation("MonthlyFlowReportReceiver")
  monthlyFlowReportsReviewed      MonthlyFlowReport[]     @relation("MonthlyFlowReportReviewer")
  waterQualityLabReportsPrepared  WaterQualityLabReport[] @relation("WaterQualityLabReportPreparer")
  waterQualityLabReportsSubmitted WaterQualityLabReport[] @relation("WaterQualityLabReportSubmitter")
  waterQualityLabReportsReceived  WaterQualityLabReport[] @relation("WaterQualityLabReportReceiver")
  waterQualityLabReportsReviewed  WaterQualityLabReport[] @relation("WaterQualityLabReportReviewer")
  storageLocationsCreated         StorageLocation[]       @relation("StorageLocationCreator")
  weightReportsSubmitted          WeightReport[]          @relation("WeightReportSubmitter")
  weightReportsReceived           WeightReport[]          @relation("WeightReportReceiver")
  weightReportsReviewed           WeightReport[]          @relation("WeightReportReviewer")
  dispatchOrdersOrdered           DispatchOrder[]         @relation("DispatchOrderOrderer")
  dispatchOrdersCreated           DispatchOrder[]         @relation("DispatchOrderCreator")

  // Man Hour Relations
  manHoursCreated ManHour[] @relation("ManHourCreator")

  // Audit Relations
  auditsCreated       Audit[]           @relation("AuditCreator")
  auditItemsAssigned  AuditItemToUser[] @relation("AuditItemAssignee")
  auditsAsAuditor     AuditToUser[]     @relation("AuditAuditor")
  auditPeriodsCreated AuditPeriod[]     @relation("AuditPeriodCreator")

  // Incident Relations
  incidentsAsRequester  Incident[]   @relation("IncidentRequester")
  incidentsAsReporter   Incident[]   @relation("IncidentReporter")
  incidentsAsTechnician Incident[]   @relation("IncidentTechnician")
  incidentsAsAssignee   Incident[]   @relation("IncidentAssignee")
  incidentsCreated      Incident[]   @relation("IncidentCreator")
  permissions           Permission[] @relation("PermissionToUser")
  hseTargetsCreated     HseTarget[]  @relation("HseTargetCreator")

  // Investigation Report Relations
  investigationReportsCreated      InvestigationReport[]     @relation("InvestigationReportCreator")
  investigationReportsHsSigned     InvestigationReport[]     @relation("InvestigationReportHsSigner")
  investigationActionPlansVerified InvestigationActionPlan[] @relation("InvestigationActionPlanVerifier")

  @@index([email])
  @@map("t_users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@map("t_refresh_tokens")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  email     String
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@map("t_password_reset_tokens")
}

enum DataLevelEnum {
  SELF
  DEPARTMENT
  SUPER
}

model Role {
  id                     String                  @id @default(uuid())
  name                   String
  code                   String
  description            String?
  isActive               Boolean                 @default(true)
  dataLevel              DataLevelEnum           @default(SUPER)
  deletedAt              DateTime?
  deletedBy              String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  users                  User[]
  menus                  Menu[]                  @relation("MenuToRole")
  permissions            Permission[]            @relation("PermissionToRole")
  notificationRecipients NotificationRecipient[]

  @@index([name])
  @@index([code])
  @@map("m_roles")
}

model Permission {
  id          String    @id @default(uuid())
  name        String
  description String?
  isActive    Boolean   @default(true)
  deletedAt   DateTime?
  deletedBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  roles       Role[]    @relation("PermissionToRole")
  users       User[]    @relation("PermissionToUser")

  @@index([name])
  @@map("m_permissions")
}

model Menu {
  id        String    @id @default(uuid())
  name      String
  path      String?
  icon      String?
  parentId  String?
  order     Int
  isActive  Boolean   @default(true)
  deletedAt DateTime?
  deletedBy String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  parent    Menu?     @relation("MenuHierarchy", fields: [parentId], references: [id])
  children  Menu[]    @relation("MenuHierarchy")
  roles     Role[]    @relation("MenuToRole")

  @@map("m_menus")
}

model Office {
  id              String           @id @default(uuid())
  name            String
  code            String
  description     String?
  address         String?
  phone           String?
  email           String?
  parentId        String?
  isActive        Boolean          @default(true)
  deletedAt       DateTime?
  deletedBy       String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  parent          Office?          @relation("OfficeHierarchy", fields: [parentId], references: [id])
  children        Office[]         @relation("OfficeHierarchy")
  users           User[]
  areas           Area[]
  treatmentPlants TreatmentPlant[]

  @@index([code])
  @@map("m_offices")
}

model Department {
  id                                  String                  @id @default(uuid())
  name                                String
  code                                String
  description                         String?                 @db.Text
  emails                              Json? // Array of email addresses for the department
  isActive                            Boolean                 @default(true)
  deletedAt                           DateTime?
  deletedBy                           String?
  createdAt                           DateTime                @default(now())
  updatedAt                           DateTime                @default(now())
  users                               User[]
  riskAssessments                     RiskAssessment[]
  approvals                           Approval[]
  ppeWithdrawals                      PPEWithdrawal[]
  certificates                        Certificate[]
  notificationRecipients              NotificationRecipient[]
  inspectionItems                     InspectionItem[]
  auditItemToDepartments              AuditItemToDepartment[]
  incidentsAssigned                   Incident[]
  incidentInjuredPersons              IncidentInjuredPerson[] @relation("IncidentInjuredPersonDepartment")
  incidentWitnesses                   IncidentWitness[]       @relation("IncidentWitnessDepartment")
  certificateCategoryResponsibilities CertificateCategory[]   @relation("CertificateCategoryResponsibleDepartments")

  @@index([code])
  @@map("m_departments")
}

model JobPosition {
  id                     String                  @id @default(uuid())
  name                   String
  code                   String
  level                  Int
  description            String?                 @db.Text
  isActive               Boolean                 @default(true)
  deletedAt              DateTime?
  deletedBy              String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @default(now())
  users                  User[]
  approvals              Approval[]
  ppeWithdrawals         PPEWithdrawal[]
  notificationRecipients NotificationRecipient[]

  @@index([code])
  @@map("m_job_positions")
}

model RiskCategory {
  id                  String               @id @default(uuid())
  name                String
  code                String
  description         String?              @db.Text
  isActive            Boolean              @default(true)
  deletedAt           DateTime?
  deletedBy           String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  risks               Risk[]
  riskAssessmentItems RiskAssessmentItem[]
  inspectionItems     InspectionItem[]
  incidents           Incident[]

  @@index([code])
  @@map("m_risk_categories")
}

model Risk {
  id                                         String                                      @id @default(uuid())
  name                                       String
  code                                       String
  description                                String?                                     @db.Text
  isActive                                   Boolean                                     @default(true)
  deletedAt                                  DateTime?
  deletedBy                                  String?
  createdAt                                  DateTime                                    @default(now())
  updatedAt                                  DateTime                                    @updatedAt
  riskCategoryId                             String
  riskCategory                               RiskCategory                                @relation(fields: [riskCategoryId], references: [id])
  mitigations                                RiskMitigation[]
  workClassifications                        WorkClassificationRiskEquipment[]
  workPermitClassificationSafetyGuidanceRows WorkPermitClassificationSafetyGuidanceRow[]
  riskAssessmentItems                        RiskAssessmentItem[]
  workPermitHazards                          WorkPermitHazard[]
  inspectionItems                            InspectionItem[]

  @@index([code])
  @@map("m_risk")
}

model RiskMitigation {
  id                          String    @id @default(uuid())
  eliminationControl          String?   @db.Text
  substitutionControl         String?   @db.Text
  engineeringControl          String?   @db.Text
  administrationControl       String?   @db.Text
  personalProtectiveEquipment String?   @db.Text
  transfer                    String?   @db.Text
  accept                      String?   @db.Text
  isActive                    Boolean   @default(true)
  deletedAt                   DateTime?
  deletedBy                   String?
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt
  riskId                      String
  risk                        Risk      @relation(fields: [riskId], references: [id])

  @@map("m_risk_mitigations")
}

model RiskControl {
  id                          String   @id @default(uuid())
  eliminationControl          String?  @db.Text
  substitutionControl         String?  @db.Text
  engineeringControl          String?  @db.Text
  administrationControl       String?  @db.Text
  personalProtectiveEquipment String?  @db.Text
  transfer                    String?  @db.Text
  isOpen                      Boolean  @default(true)
  isAccept                    Boolean  @default(false)
  isActive                    Boolean  @default(true)
  entity                      String
  entityId                    String
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  @@index([entity, entityId])
  @@index([isActive])
  @@map("t_risk_control")
}

// Risk Mitigation - Transactional Data (Polymorphic)
// Supports RISK_ASSESSMENT_ITEM and INSPECTION_ITEM entity types
// Related to RiskAssessmentItem (entity='RISK_ASSESSMENT_ITEM') and InspectionItem (entity='INSPECTION_ITEM')
// 1-to-1 relationship: Each RiskAssessmentItem or InspectionItem can have one RiskMitigationRecord
model RiskMitigationRecord {
  id                          String    @id @default(uuid())
  code                        String // Auto-generated code with prefix RSK{datetime}, not user-updatable; unique for non-deleted rows (partial index)
  eliminationControl          String?   @db.Text
  substitutionControl         String?   @db.Text
  engineeringControl          String?   @db.Text
  administrationControl       String?   @db.Text
  personalProtectiveEquipment String?   @db.Text
  transfer                    String?   @db.Text
  accept                      String?   @db.Text
  legalAspect                 String?   @db.Text
  isActive                    Boolean   @default(true)
  entity                      String // Entity type identifier (RISK_ASSESSMENT_ITEM, INSPECTION_ITEM)
  entityId                    String // Entity ID - references t_risk_assessment_item.id or t_inspection_items.id
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt
  deletedAt                   DateTime?
  deletedBy                   String?

  @@index([code])
  @@index([entity, entityId])
  @@index([isActive])
  @@map("t_risk_mitigation")
}

enum RiskRatingEnum {
  LOW
  MEDIUM
  HIGH
  EXTREME
}

model RiskMatrix {
  id               String         @id @default(uuid())
  likelihoodLevel  String
  likelihoodName   String         @default("")
  likelihoodDesc   String         @default("") @db.Text
  consequenceLevel Int
  consequenceName  String         @default("")
  consequenceDesc  String         @default("") @db.Text
  interpretation   RiskRatingEnum
  isActive         Boolean        @default(true)
  deletedAt        DateTime?
  deletedBy        String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@map("m_risk_matrix")
}

model RiskAssessment {
  id                String                       @id @default(uuid())
  code              String // Unique for non-deleted rows (partial index)
  description       String?                      @db.Text
  departmentId      String
  department        Department                   @relation(fields: [departmentId], references: [id])
  assessmentDate    DateTime                     @default(now())
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt
  createdBy         String
  creator           User                         @relation("RiskAssessmentCreator", fields: [createdBy], references: [id])
  status            GeneralStatusEnum
  isActive          Boolean                      @default(true)
  items             RiskAssessmentItem[]
  assigneeId        String?
  assignee          User?                        @relation(fields: [assigneeId], references: [id])
  actionPlan        String?                      @db.Text
  zohoTicketMapping ZohoTicketRiskAssessmentMap?
  deletedAt         DateTime?
  deletedBy         String?

  @@index([code])
  @@map("t_risk_assessment")
}

model RiskAssessmentItem {
  id                   String                    @id @default(uuid())
  riskAssessmentId     String
  riskAssessment       RiskAssessment            @relation(fields: [riskAssessmentId], references: [id])
  mRiskId              String                    @map("mriskid")
  mRisk                Risk                      @relation(fields: [mRiskId], references: [id])
  mRiskCategoryId      String
  mRiskCategory        RiskCategory              @relation(fields: [mRiskCategoryId], references: [id])
  likelihoodLevel      String
  consequenceLevel     Int
  riskMatrixRating     String
  interpretation       RiskRatingEnum
  postLikelihoodLevel  String
  postConsequenceLevel Int
  postRiskMatrixRating String
  postInterpretation   RiskRatingEnum
  images               RiskAssessmentItemImage[]
  deletedAt            DateTime?
  deletedBy            String?

  @@map("t_risk_assessment_item")
}

// Risk Assessment Item Image - Transactional Data
// Supports before/after action plan tracking (same pattern as InspectionImage)
model RiskAssessmentItemImage {
  id                   String                          @id @default(uuid())
  riskAssessmentItemId String
  imageUrl             String
  caption              String?                         @db.Text
  type                 RiskAssessmentItemImageTypeEnum @default(GENERAL) // BEFORE: before action plan, AFTER: after action plan, GENERAL: general image
  order                Int
  createdAt            DateTime                        @default(now())

  riskAssessmentItem RiskAssessmentItem @relation(fields: [riskAssessmentItemId], references: [id], onDelete: Cascade)

  @@index([riskAssessmentItemId])
  @@index([riskAssessmentItemId, type])
  @@index([order])
  @@map("t_risk_assessment_item_images")
}

model MasterApproval {
  id        String               @id @default(uuid())
  entity    String
  isActive  Boolean              @default(true)
  deletedAt DateTime?
  deletedBy String?
  items     MasterApprovalItem[]

  @@map("m_approval")
}

model MasterApprovalItem {
  id            String         @id @default(uuid())
  mApprovalId   String
  mApproval     MasterApproval @relation(fields: [mApprovalId], references: [id])
  order         Int
  jobPositionId String
  departmentId  String
  createdBy     String
  createdAt     DateTime       @default(now())
  // Relations removed to support sentinel values (@ENTITY_DEPARTMENT, @ENTITY_JOB_POSITION)
  // Relations are loaded manually via loadItemRelations() to handle sentinel values
  // No foreign key constraints - jobPositionId and departmentId are plain String fields
  creator       User           @relation("CreatedApprovalItems", fields: [createdBy], references: [id])

  @@map("m_approval_item")
}

model Approval {
  id            String      @id @default(uuid())
  mApprovalId   String
  entityId      String
  departmentId  String
  jobPositionId String
  status        String
  notes         String
  createdAt     DateTime    @default(now())
  createdBy     String
  department    Department  @relation(fields: [departmentId], references: [id])
  jobPosition   JobPosition @relation(fields: [jobPositionId], references: [id])
  creator       User        @relation("CreatedApprovals", fields: [createdBy], references: [id])

  @@map("t_approvals")
}

model Setting {
  id        String    @id @default(uuid())
  key       String // unique among non-deleted rows (partial index)
  value     String
  isActive  Boolean   @default(true)
  deletedAt DateTime?
  deletedBy String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([key])
  @@map("m_settings")
}

// Zoho Webhook Logs - Transactional Data
model TZohoWebhookLogs {
  id               String   @id @default(uuid())
  requestId        String   @unique // X-Zoho-Request-Id header for idempotency
  eventType        String // Event type (e.g., contact.created, lead.updated)
  eventKey         String   @unique
  ticketId         String?
  correlationId    String?
  status           String // RECEIVED | PROCESSED | IGNORED_DUPLICATE | FAILED
  payload          Json // Full webhook payload
  payloadSanitized Json?
  errorMessage     String?  @db.Text // Error message if status is failed
  errorSummary     String?
  processedAt      DateTime @default(now())
  createdAt        DateTime @default(now())

  @@index([requestId])
  @@index([eventType])
  @@index([status])
  @@index([ticketId])
  @@index([processedAt])
  @@map("t_zoho_webhook_logs")
}

enum ZohoOutboundJobStatusEnum {
  PENDING
  PROCESSING
  SUCCESS
  FAILED_RETRY
  FAILED_DEAD_LETTER
}

model ZohoTicketRiskAssessmentMap {
  id               String             @id @default(uuid())
  zohoTicketId     String             @unique @map("zoho_ticket_id")
  zohoTicketNumber String?            @map("zoho_ticket_number")
  hseTaskId        String             @unique @map("hse_task_id")
  hseTask          RiskAssessment     @relation(fields: [hseTaskId], references: [id], onDelete: Cascade)
  lastZohoStatus   String?            @map("last_zoho_status")
  lastHseStatus    GeneralStatusEnum? @map("last_hse_status")
  rawPayload       Json               @map("raw_payload")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  outboundJobs     ZohoOutboundJob[]

  @@index([hseTaskId])
  @@map("t_zoho_ticket_risk_assessment_map")
}

model ZohoOutboundJob {
  id              String                      @id @default(uuid())
  mappingId       String                      @map("mapping_id")
  mapping         ZohoTicketRiskAssessmentMap @relation(fields: [mappingId], references: [id], onDelete: Cascade)
  ticketId        String                      @map("ticket_id")
  targetStatus    String                      @map("target_status")
  requestPayload  Json                        @map("request_payload")
  responsePayload Json?                       @map("response_payload")
  status          ZohoOutboundJobStatusEnum   @default(PENDING)
  attemptCount    Int                         @default(0) @map("attempt_count")
  maxAttempts     Int                         @default(6) @map("max_attempts")
  nextRetryAt     DateTime                    @default(now()) @map("next_retry_at")
  lastError       String?                     @map("last_error") @db.Text
  correlationId   String?                     @map("correlation_id")
  processedAt     DateTime?                   @map("processed_at")
  createdAt       DateTime                    @default(now()) @map("created_at")
  updatedAt       DateTime                    @updatedAt @map("updated_at")

  @@index([status, nextRetryAt])
  @@index([ticketId])
  @@map("t_zoho_outbound_jobs")
}

// Notification System Models
model NotificationType {
  id            String         @id @default(uuid())
  name          String         @unique
  description   String?
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  notifications Notification[]

  @@map("m_notification_types")
}

model Notification {
  id        String    @id @default(uuid())
  title     String
  message   String
  context   String? // Module/context where notification was triggered
  contextId String? // Specific ID of the context (e.g., user ID, document ID)
  typeId    String
  isRead    Boolean   @default(false)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  readAt    DateTime?

  // Relations
  type         NotificationType        @relation(fields: [typeId], references: [id])
  recipients   NotificationRecipient[]
  createdBy    String
  creator      User                    @relation("NotificationCreator", fields: [createdBy], references: [id])
  reminderLogs ReminderLog[]

  @@map("t_notifications")
}

model NotificationRecipient {
  id             String    @id @default(uuid())
  notificationId String
  roleId         String
  userId         String? // Optional: specific user if targeting individual
  departmentId   String? // Optional: target specific department
  jobPositionId  String? // Optional: target specific job position
  isRead         Boolean   @default(false)
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  // Relations
  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id])
  user         User?        @relation("NotificationRecipient", fields: [userId], references: [id])
  department   Department?  @relation(fields: [departmentId], references: [id])
  jobPosition  JobPosition? @relation(fields: [jobPositionId], references: [id])

  @@unique([notificationId, roleId, userId, departmentId, jobPositionId])
  @@map("t_notification_recipients")
}

// File Storage Provider - Master Data
model FileStorageProvider {
  id        String   @id @default(uuid())
  name      String   @unique // "local", "aws-s3", "google-cloud"
  config    Json // Provider-specific configuration
  isActive  Boolean  @default(true)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  fileUploads FileUpload[]

  @@map("m_file_storage_providers")
}

