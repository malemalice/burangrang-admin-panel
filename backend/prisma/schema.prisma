// Treatment Plant - Master Data
model TreatmentPlant {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  location    String
  capacity    Decimal? @db.Decimal(12, 4)
  description String?  @db.Text
  officeId    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String

  // Relations
  office                 Office?                 @relation(fields: [officeId], references: [id])
  creator                User                    @relation("TreatmentPlantCreator", fields: [createdBy], references: [id])
