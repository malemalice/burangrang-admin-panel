// ============================================================
// INCIDENT REPORT SYSTEM - Transactional Data
// ============================================================

// Incident - Transactional Data
model Incident {
  id                    String                    @id @default(uuid())
  code                  String                    @unique
  subject               String
  incidentDate          DateTime
  roomId                String?
  areaId                String
  incidentType          IncidentTypeEnum
  incidentClassification IncidentClassificationEnum
  activities            IncidentActivitiesEnum       @default(WORK)
  type                  IncidentScopeEnum            @default(GENERAL)
  requesterId           String
  reportedBy            String
  technicianId          String?
  priority              PriorityEnum              @default(NORMAL)
  riskCategoryId        String
  description           String?                   @db.Text
  controlMeasure        String?                  @db.Text
  dueDate               DateTime?
  expectedOutcome       String?                  @db.Text
  needToStopActivity    StopActivityEnum         @default(NOT_SPECIFIED)
  stopActivityDescription String?                 @db.Text
  treatment             TreatmentEnum            @default(NOT_SPECIFIED)
  treatmentDescription  String?                  @db.Text
  absence               AbsenceEnum              @default(NOT_SPECIFIED)
  resolution            String?                  @db.Text
  assignedDepartmentId  String
  assigneeId            String?
  status                GeneralStatusEnum
  source                SourceEnum               @default(SYSTEM)
  isActive              Boolean                  @default(true)
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  createdBy             String

  // Relations
  room                  Room?                    @relation(fields: [roomId], references: [id])
  area                  Area                     @relation(fields: [areaId], references: [id])
  riskCategory          RiskCategory             @relation(fields: [riskCategoryId], references: [id])
  requester             User                     @relation("IncidentRequester", fields: [requesterId], references: [id])
  reporter              User                     @relation("IncidentReporter", fields: [reportedBy], references: [id])
  technician            User?                    @relation("IncidentTechnician", fields: [technicianId], references: [id])
  assignedDepartment    Department               @relation(fields: [assignedDepartmentId], references: [id])
  assignee              User?                    @relation("IncidentAssignee", fields: [assigneeId], references: [id])
  creator               User                     @relation("IncidentCreator", fields: [createdBy], references: [id])
  injuredPersons        IncidentInjuredPerson[]
  witnesses             IncidentWitness[]
  assets                IncidentAsset[]
  images                IncidentImage[]
  attachments           IncidentAttachment[]

  @@index([code])
  @@index([roomId])
  @@index([areaId])
  @@index([riskCategoryId])
  @@index([requesterId])
  @@index([reportedBy])
  @@index([assignedDepartmentId])
  @@index([assigneeId])
  @@index([status])
  @@index([source])
  @@index([activities])
  @@index([type])
  @@map("t_incidents")
}

// Incident Injured Person - Transactional Data
model IncidentInjuredPerson {
  id                String                @id @default(uuid())
  incidentId        String
  injuredPersonName String?
  gender            GenderEnum?
  levelOfInjury     LevelOfInjuryEnum     @default(NOT_SPECIFIED)
  injuredBodyPart   InjuredBodyPartEnum   @default(NOT_SPECIFIED)
  typeOfInjury      TypeOfInjuryEnum      @default(NOT_SPECIFIED)
  mechanismOfInjury MechanismOfInjuryEnum  @default(NOT_SPECIFIED)
  departmentId      String?
  order             Int
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  // Relations
  incident          Incident              @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  department        Department?           @relation("IncidentInjuredPersonDepartment", fields: [departmentId], references: [id])

  @@index([incidentId])
  @@index([departmentId])
  @@map("t_incident_injured_persons")
}

// Incident Witness - Transactional Data
model IncidentWitness {
  id          String        @id @default(uuid())
  incidentId String
  witnessName String?
  gender      GenderEnum?
  departmentId String?
  order       Int
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Relations
  incident    Incident      @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  department  Department?    @relation("IncidentWitnessDepartment", fields: [departmentId], references: [id])

  @@index([incidentId])
  @@index([departmentId])
  @@map("t_incident_witnesses")
}

// Incident Asset - Transactional Data (Polymorphic)
// Supports ASSET, HEAVY_EQUIPMENT, and SAFETY_EQUIPMENT entity types
// Can reference m_assets (entity='ASSET'), m_heavy_equipment (entity='HEAVY_EQUIPMENT'), or m_safety_equipment (entity='SAFETY_EQUIPMENT')
// Free-text fallback: If entity is null, assetName and assetCode are used
model IncidentAsset {
  id          String                @id @default(uuid())
  incidentId  String
  // Polymorphic reference
  entity      EquipmentEntityEnum?  // Entity type identifier (ASSET, HEAVY_EQUIPMENT, SAFETY_EQUIPMENT)
  entityId    String?               // Entity ID - references m_assets.id, m_heavy_equipment.id, or m_safety_equipment.id
  // Free-text fields (used when entity is null or as fallback)
  assetName   String
  assetCode   String?
  quantity    Int?                     // Quantity of the asset
  order       Int
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  // Relations
  incident        Incident          @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  // Note: Polymorphic relations (asset, heavyEquipment, safetyEquipment) are handled manually in application code
  // Prisma doesn't support multiple foreign keys on the same field, so we load these relations manually

  @@index([incidentId])
  @@index([entity, entityId])
  @@map("t_incident_assets")
}

// Incident Image - Transactional Data
model IncidentImage {
  id          String   @id @default(uuid())
  incidentId  String
  imageUrl    String
  caption     String?  @db.Text
  order       Int
  createdAt   DateTime @default(now())

  // Relations
  incident    Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
  @@index([order])
  @@map("t_incident_images")
}

// Incident Attachment - Transactional Data
model IncidentAttachment {
  id            String   @id @default(uuid())
  incidentId    String
  attachmentUrl String
  order         Int
  createdAt     DateTime @default(now())

  // Relations
  incident      Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
  @@index([order])
  @@map("t_incident_attachments")
}

// ============================================================
// AUDIT SYSTEM - Master Data
// ============================================================

// Audit Element - Master Data
model AuditElement {
  id          String        @id @default(uuid())
  name        String
  code        String        @unique
  description String?      @db.Text
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Relations
  clauses AuditClause[]
  audits  Audit[]

  @@map("m_audit_element")
}

// Audit Clause - Master Data
model AuditClause {
  id             String        @id @default(uuid())
  name           String
  code           String        @unique
  description    String?      @db.Text
  auditElementId String
  order          Int
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Relations
  auditElement AuditElement  @relation(fields: [auditElementId], references: [id])
  criteria     AuditCriteria[]

  @@index([auditElementId])
  @@index([order])
  @@map("m_audit_clause")
}

// Audit Criteria - Master Data
model AuditCriteria {
  id             String            @id @default(uuid())
  name           String
  code           String            @unique
  description    String?           @db.Text
  auditClauseId  String
  transitionType TransitionTypeEnum
  order          Int
  isActive       Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  // Relations
  auditClause AuditClause @relation(fields: [auditClauseId], references: [id])
  auditItems  AuditItem[]

  @@index([auditClauseId])
  @@index([order])
  @@map("m_audit_criteria")
}

// ============================================================
// AUDIT SYSTEM - Transactional Data
// ============================================================

enum CompliantStatusEnum {
  COMPLY
  NOT_COMPLY_MAJOR
  NOT_COMPLY_MINOR
}

// Audit - Transactional Data
model Audit {
  id             String         @id @default(uuid())
  code           String         @unique
  auditDate      DateTime
  auditElementId String
  status         GeneralStatusEnum
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  createdBy      String

  // Relations
  areas       AuditToArea[]
  auditElement AuditElement @relation(fields: [auditElementId], references: [id])
  creator     User         @relation("AuditCreator", fields: [createdBy], references: [id])
  items       AuditItem[]
  auditors    AuditToUser[]

  @@index([auditElementId])
  @@index([status])
  @@map("t_audits")
}

// Audit Item - Transactional Data
model AuditItem {
  id               String                @id @default(uuid())
  auditId          String
  auditCriteriaId  String
  status           GeneralStatusEnum     @default(OPEN)
  compliantStatus  CompliantStatusEnum
  evidence         String?               @db.Text
  recommendation   String?               @db.Text
  actionRealization String?              @db.Text
  order            Int
  dueDate          DateTime
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  // Relations
  audit          Audit                   @relation(fields: [auditId], references: [id], onDelete: Cascade)
  auditCriteria  AuditCriteria           @relation(fields: [auditCriteriaId], references: [id])
  departments    AuditItemToDepartment[]
  users          AuditItemToUser[]
  images         AuditImage[]

  @@index([auditId])
  @@index([auditCriteriaId])
  @@index([status])
  @@map("t_audit_items")
}

// Audit Image - Transactional Data
model AuditImage {
  id           String    @id @default(uuid())
  auditItemId  String
  imageUrl     String
  caption      String?   @db.Text
  order        Int
  createdAt    DateTime  @default(now())

  // Relations
  auditItem AuditItem @relation(fields: [auditItemId], references: [id], onDelete: Cascade)

  @@index([auditItemId])
  @@index([order])
  @@map("t_audit_images")
}

// Audit Item to Department - Many-to-Many Junction Table
model AuditItemToDepartment {
  id               String    @id @default(uuid())
  auditItemId      String
  departmentId     String
  createdAt        DateTime  @default(now())

  // Relations
  auditItem  AuditItem   @relation(fields: [auditItemId], references: [id], onDelete: Cascade)
  department Department  @relation(fields: [departmentId], references: [id])

  @@unique([auditItemId, departmentId])
  @@index([auditItemId])
  @@index([departmentId])
  @@map("_AuditItemToDepartment")
}

// Audit Item to User - Many-to-Many Junction Table (optional users)
model AuditItemToUser {
  id          String   @id @default(uuid())
  auditItemId String
  userId      String
  createdAt   DateTime @default(now())

  // Relations
  auditItem AuditItem @relation(fields: [auditItemId], references: [id], onDelete: Cascade)
  user      User      @relation("AuditItemAssignee", fields: [userId], references: [id])

  @@unique([auditItemId, userId])
  @@index([auditItemId])
  @@index([userId])
  @@map("_AuditItemToUser")
}

// Audit to Area - Many-to-Many Junction Table
model AuditToArea {
  id        String   @id @default(uuid())
  auditId   String
  areaId    String
  createdAt DateTime @default(now())

  // Relations
  audit Audit @relation(fields: [auditId], references: [id], onDelete: Cascade)
  area  Area  @relation(fields: [areaId], references: [id])

  @@unique([auditId, areaId])
  @@index([auditId])
  @@index([areaId])
  @@map("_AuditToArea")
}

// Audit to User - Many-to-Many Junction Table (auditors)
model AuditToUser {
  id        String   @id @default(uuid())
  auditId   String
  userId    String
  createdAt DateTime @default(now())

  // Relations
  audit Audit @relation(fields: [auditId], references: [id], onDelete: Cascade)
  user  User  @relation("AuditAuditor", fields: [userId], references: [id])

  @@unique([auditId, userId])
  @@index([auditId])
  @@index([userId])
  @@map("_AuditToUser")
}

// ============================================================
// WASTEWATER MANAGEMENT - Master Data
// ============================================================

// Treatment Plant - Master Data
model TreatmentPlant {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  location    String
  capacity    Decimal? @db.Decimal(12, 4)
  description String?  @db.Text
  officeId    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String

  // Relations
  office                 Office?                 @relation(fields: [officeId], references: [id])
  creator                User                    @relation("TreatmentPlantCreator", fields: [createdBy], references: [id])
  monthlyFlowReports     MonthlyFlowReport[]
  waterQualityLabReports WaterQualityLabReport[]

  @@map("m_treatment_plants")
}

// Water Quality Parameter - Master Data
model WaterQualityParameter {
  id              String   @id @default(uuid())
  name            String
  code            String   @unique
  unit            String
  standardLimit   Decimal? @db.Decimal(10, 4)
  regulatoryLimit Decimal? @db.Decimal(10, 4)
  testMethod      String?
  description     String?  @db.Text
  isActive        Boolean  @default(true)
  dateSampleTaken DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("m_water_quality_parameters")
}

// ============================================================
// WASTEWATER MANAGEMENT - Transactional Data
// ============================================================

// Monthly Flow Report - Transactional Data
model MonthlyFlowReport {
  id                String           @id @default(uuid())
  reportCode        String           @unique
  treatmentPlantId  String
  reportMonth       MonthEnum
  reportYear        Int
  totalVolume       Decimal          @db.Decimal(12, 4)
  averageDailyFlow  Decimal          @db.Decimal(10, 4)
  peakFlow          Decimal?         @db.Decimal(10, 4)
  minimumFlow       Decimal?         @db.Decimal(10, 4)
  reportDocumentUrl String?
  submittedBy       String
  submittedAt       DateTime
  receivedBy        String?
  receivedAt        DateTime?
  status            ReportStatusEnum @default(SUBMITTED)
  reviewedBy        String?
  reviewedAt        DateTime?
  reviewNotes       String?          @db.Text
  archivedAt        DateTime?
  isActive          Boolean          @default(true)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  // Relations
  treatmentPlant TreatmentPlant @relation(fields: [treatmentPlantId], references: [id])
  submitter      User           @relation("MonthlyFlowReportSubmitter", fields: [submittedBy], references: [id])
  receiver       User?          @relation("MonthlyFlowReportReceiver", fields: [receivedBy], references: [id])
  reviewer       User?          @relation("MonthlyFlowReportReviewer", fields: [reviewedBy], references: [id])

  @@unique([treatmentPlantId, reportMonth, reportYear])
  @@index([reportMonth, reportYear])
  @@index([status])
  @@index([receivedAt])
  @@map("t_monthly_flow_reports")
}

// Water Quality Lab Report - Transactional Data
model WaterQualityLabReport {
  id                String           @id @default(uuid())
  reportCode        String           @unique
  treatmentPlantId  String
  reportDate        DateTime
  preparedBy        String
  reportDocumentUrl String?
  summary           String?          @db.Text
  recommendations   String?          @db.Text
  analystSignature  String?
  submittedBy       String
  submittedAt       DateTime
  receivedBy        String?
  receivedAt        DateTime?
  status            ReportStatusEnum @default(SUBMITTED)
  reviewedBy        String?
  reviewedAt        DateTime?
  reviewNotes       String?          @db.Text
  archivedAt        DateTime?
  isActive          Boolean          @default(true)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  // Relations
  treatmentPlant TreatmentPlant @relation(fields: [treatmentPlantId], references: [id])
  preparer       User           @relation("WaterQualityLabReportPreparer", fields: [preparedBy], references: [id])
  submitter      User           @relation("WaterQualityLabReportSubmitter", fields: [submittedBy], references: [id])
  receiver       User?          @relation("WaterQualityLabReportReceiver", fields: [receivedBy], references: [id])
  reviewer       User?          @relation("WaterQualityLabReportReviewer", fields: [reviewedBy], references: [id])

  @@index([treatmentPlantId, reportDate])
  @@index([reportDate])
  @@index([status])
  @@index([receivedAt])
  @@map("t_water_quality_lab_reports")
}

// ============================================================
// SOLID WASTE MANAGEMENT - Master Data
// ============================================================

// Waste Type - Master Data
model WasteType {
  id                      String        @id @default(uuid())
  name                    String
  code                    String        @unique
  wasteType               WasteTypeEnum
  description             String?       @db.Text
  requiresSpecialHandling Boolean       @default(false)
  isActive                Boolean       @default(true)
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  // Relations
  weightReportItems WeightReportItem[]

  @@map("m_waste_types")
}

// Waste Source - Master Data
model WasteSource {
  id            String   @id @default(uuid())
  name          String
  code          String   @unique
  sourceType    String
  description   String?  @db.Text
  contactPerson String?
  phone         String?
  email         String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  weightReports WeightReport[]

  @@map("m_waste_sources")
}

// Storage Location - Master Data
model StorageLocation {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  location    String
  areaId      String?
  description String?  @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String

  // Relations
  area          Area?          @relation(fields: [areaId], references: [id])
  creator       User           @relation("StorageLocationCreator", fields: [createdBy], references: [id])
  weightReports WeightReport[]

  @@map("m_storage_locations")
}

// ============================================================
// SOLID WASTE MANAGEMENT - Transactional Data
// ============================================================

// Weight Report - Transactional Data
model WeightReport {
  id                String           @id @default(uuid())
  reportCode        String           @unique
  sourceId          String
  storageLocationId String
  reportDate        DateTime
  reportMonth       MonthEnum
  reportYear        Int
  reportDocumentUrl String?
  submittedBy       String
  submittedAt       DateTime
  receivedBy        String?
  receivedAt        DateTime?
  status            ReportStatusEnum @default(SUBMITTED)
  reviewedBy        String?
  reviewedAt        DateTime?
  reviewNotes       String?          @db.Text
  archivedAt        DateTime?
  isActive          Boolean          @default(true)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  // Relations
  source          WasteSource        @relation(fields: [sourceId], references: [id])
  storageLocation StorageLocation    @relation(fields: [storageLocationId], references: [id])
  submitter       User               @relation("WeightReportSubmitter", fields: [submittedBy], references: [id])
  receiver        User?              @relation("WeightReportReceiver", fields: [receivedBy], references: [id])
  reviewer        User?              @relation("WeightReportReviewer", fields: [reviewedBy], references: [id])
  items           WeightReportItem[]

  @@unique([sourceId, reportMonth, reportYear])
  @@index([reportMonth, reportYear])
  @@index([status])
  @@index([receivedAt])
  @@map("t_weight_reports")
}

// Weight Report Item - Transactional Data
model WeightReportItem {
  id             String   @id @default(uuid())
  weightReportId String
  wasteTypeId    String
  weight         Decimal  @db.Decimal(10, 2)
  unit           String   @default("kg")
  order          Int
  notes          String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  weightReport WeightReport @relation(fields: [weightReportId], references: [id], onDelete: Cascade)
  wasteType    WasteType    @relation(fields: [wasteTypeId], references: [id])

  @@unique([weightReportId, wasteTypeId])
  @@map("t_weight_report_items")
}

// Dispatch Order - Transactional Data
model DispatchOrder {
  id           String            @id @default(uuid())
  dispatchCode String            @unique
  dispatchDate DateTime
  orderedBy    String
  quantity     Decimal           @db.Decimal(10, 2)
  memo         String?           @db.Text
  status       GeneralStatusEnum @default(DRAFT)
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  createdBy    String

  // Relations
  orderer User @relation("DispatchOrderOrderer", fields: [orderedBy], references: [id])
  creator User @relation("DispatchOrderCreator", fields: [createdBy], references: [id])

  @@index([dispatchDate])
  @@index([orderedBy])
  @@index([status])
  @@map("t_dispatch_orders")
}

// ============================================================
// MAN HOUR MANAGEMENT
// ============================================================

// Man Hour - Transactional Data
model ManHour {
  id            String           @id @default(uuid())
  name          String
  group         ManHourGroupEnum
  qty           Int
  manHourPerDay Decimal          @db.Decimal(4, 2)
  month         MonthEnum
  year          Int
  total         Decimal          @db.Decimal(10, 2)
  notes         String?          @db.Text
  isActive      Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  createdBy     String

  // Relations
  creator User @relation("ManHourCreator", fields: [createdBy], references: [id])

  @@unique([name, group, month, year])
  @@index([month, year])
  @@index([group])
  @@map("t_man_hours")
}

// ============================================================
// KPI HSE TARGET
// ============================================================

// HSE Target - Transactional Data
// Targets for actual vs target comparison across modules (incident, risk, inspection, audit)
model HseTarget {
  id        String           @id @default(uuid())
  type      HseTargetTypeEnum
  code      String
  name      String?
  month     MonthEnum?
  year      Int
  target    Decimal          @db.Decimal(10, 2)
  isActive  Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  createdBy String

  // Relations
  creator User @relation("HseTargetCreator", fields: [createdBy], references: [id])

  @@unique([type, code, month, year])
  @@index([type, year])
  @@map("t_hse_targets")
}
