// ============================================================
// INSPECTION CHECKLIST MASTER DATA
// ============================================================

// Master Inspection Checklist - Self-referencing hierarchical tree
// depth 0 (parentId=null): checklist name/group — referenced by InspectionItem.checklistId
// depth 1: numbered category headers (e.g. "1. Required Documents")
// depth 2: lettered leaf items (e.g. "A. Work Permit") — receive result rows in t_inspection_checklist_results
// Pattern follows Menu ("MenuHierarchy") and Office ("OfficeHierarchy")
model InspectionChecklist {
  id          String    @id @default(uuid())
  parentId    String?
  name        String
  code        String? // unique code for root nodes; display number/letter ("1", "A") for depth 1/2
  description String?   @db.Text
  order       Int       @default(0)
  isActive    Boolean   @default(true)
  deletedAt   DateTime?
  deletedBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  parent          InspectionChecklist?        @relation("ChecklistHierarchy", fields: [parentId], references: [id])
  children        InspectionChecklist[]       @relation("ChecklistHierarchy")
  inspectionItems InspectionItem[]
  results         InspectionChecklistResult[]

  @@index([code])
  @@index([parentId])
  @@index([parentId, order])
  @@map("m_inspection_checklists")
}

// ============================================================
// INSPECTION SYSTEM
// ============================================================

// Inspection - Transactional Data
model Inspection {
  id                   String            @id @default(uuid())
  code                 String            @unique
  inspectionDate       DateTime
  status               GeneralStatusEnum
  isActive             Boolean           @default(true)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  createdBy            String
  doneAt               DateTime?
  finalInspectionValue Float?

  // Relations
  creator    User                  @relation("InspectionCreator", fields: [createdBy], references: [id])
  items      InspectionItem[]
  inspectors InspectionInspector[]
  areas      InspectionToArea[]

  @@index([status])
  @@map("t_inspections")
}

// Inspection Item - Transactional Data
// Has 1-to-1 polymorphic relation with RiskMitigationRecord (entity='INSPECTION_ITEM', entityId=id)
model InspectionItem {
  id                   String            @id @default(uuid())
  inspectionId         String
  areaId               String
  riskCategoryId       String
  riskId               String
  assignedDepartmentId String
  assigneeId           String?
  status               GeneralStatusEnum @default(OPEN)
  findings             String?           @db.Text
  description          String?           @db.Text
  followUpNotes        String?           @db.Text
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  dueDateAt            DateTime?
  /// Optional checklist template (depth-0 root record) to use for structured assessment.
  checklistId          String?

  // Relations
  inspection         Inspection                  @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  area               Area                        @relation(fields: [areaId], references: [id])
  riskCategory       RiskCategory                @relation(fields: [riskCategoryId], references: [id])
  risk               Risk                        @relation(fields: [riskId], references: [id])
  assignedDepartment Department                  @relation(fields: [assignedDepartmentId], references: [id])
  assignee           User?                       @relation("InspectionItemAssignee", fields: [assigneeId], references: [id])
  images             InspectionImage[]
  checklist          InspectionChecklist?        @relation(fields: [checklistId], references: [id], onDelete: SetNull)
  checklistResults   InspectionChecklistResult[]

  @@index([inspectionId])
  @@index([areaId])
  @@index([riskCategoryId])
  @@index([riskId])
  @@index([assignedDepartmentId])
  @@index([assigneeId])
  @@index([status])
  @@index([checklistId])
  @@map("t_inspection_items")
}

// Inspection Image - Transactional Data
// Supports before/after fix action plan tracking
model InspectionImage {
  id               String                  @id @default(uuid())
  inspectionItemId String
  imageUrl         String
  caption          String?                 @db.Text
  type             InspectionImageTypeEnum @default(GENERAL) // BEFORE: before fix action plan, AFTER: after fix action plan, GENERAL: general inspection image
  order            Int
  createdAt        DateTime                @default(now())

  // Relations
  inspectionItem InspectionItem @relation(fields: [inspectionItemId], references: [id], onDelete: Cascade)

  @@index([inspectionItemId])
  @@index([inspectionItemId, type])
  @@index([order])
  @@map("t_inspection_images")
}

// Inspection Inspector - Transactional Data
model InspectionInspector {
  id           String   @id @default(uuid())
  inspectionId String
  inspectorId  String
  order        Int
  createdAt    DateTime @default(now())

  // Relations
  inspection Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  inspector  User       @relation("InspectionInspectorUser", fields: [inspectorId], references: [id])

  @@index([inspectionId])
  @@index([inspectorId])
  @@map("t_inspection_inspectors")
}

// Inspection to Area - Many-to-Many Junction Table
model InspectionToArea {
  id           String   @id @default(uuid())
  inspectionId String
  areaId       String
  createdAt    DateTime @default(now())

  // Relations
  inspection Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  area       Area       @relation(fields: [areaId], references: [id])

  @@unique([inspectionId, areaId])
  @@index([inspectionId])
  @@index([areaId])
  @@map("_InspectionToArea")
}

// Inspection Checklist Result - Transactional Data
// One row per (inspectionItem × checklist leaf node). Service enforces checklistItemId must be a leaf (no children).
// riskRate is nullable to allow draft saves before the inspector rates all items.
model InspectionChecklistResult {
  id               String                  @id @default(uuid())
  inspectionItemId String
  checklistItemId  String
  riskRate         InspectionRiskRateEnum?
  notes            String?                 @db.Text
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  createdBy        String

  inspectionItem InspectionItem      @relation(fields: [inspectionItemId], references: [id], onDelete: Cascade)
  checklistItem  InspectionChecklist @relation(fields: [checklistItemId], references: [id])
  creator        User                @relation("InspectionChecklistResultCreator", fields: [createdBy], references: [id])

  @@unique([inspectionItemId, checklistItemId])
  @@index([inspectionItemId])
  @@index([checklistItemId])
  @@index([riskRate])
  @@map("t_inspection_checklist_results")
}

