// Work Permit System - Transactional Data
model WorkPermit {
  id                        String   @id @default(uuid())
  code                      String   @unique
  projectName               String
  areaId                    String
  companyId                 String
  proposedStartDate         DateTime
  proposedEndDate           DateTime
  workStagesDescription     String   @db.Text
  jobSafetyAnalysis         String   @db.Text
  workRequirements          String?  @db.Text
  safetyGuideline           String?  @db.Text
  requireCourseVerification Boolean  @default(false)
  status                    String // DRAFT, OPEN, WAITING_APPROVAL, IN_REVIEW_HSE, IN_REVIEW_SECURITY, NEED_INFO, APPROVED, REJECTED, CLOSED, EXTENDED
  isActive                  Boolean  @default(true)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
  createdBy                 String

  // Relations
  area            Area                          @relation(fields: [areaId], references: [id])
  company         Company                       @relation(fields: [companyId], references: [id])
  creator         User                          @relation("WorkPermitCreator", fields: [createdBy], references: [id])
  classifications WorkPermitClassification[]
  employees       WorkPermitEmployee[]
  heavyEquipment  WorkPermitHeavyEquipment[]
  tools           WorkPermitTool[]
  materials       WorkPermitMaterial[]
  machines        WorkPermitMachine[]
  workers         WorkPermitWorker[]
  professions     WorkPermitProfession[]
  requiredCourses WorkPermitRequiredCourse[]
  hazards         WorkPermitHazard[]
  attachments     WorkPermitAttachment[]
  supervisors     WorkPermitSupervisorToGuest[]
  hseOfficers     WorkPermitToUser[]
  safetyEquipment WorkPermitToSafetyEquipment[]

  @@map("t_work_permits")
}

