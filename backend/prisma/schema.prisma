// ============================================================
// WASTEWATER MANAGEMENT - Transactional Data
// ============================================================

// Monthly Flow Report - Transactional Data
model MonthlyFlowReport {
  id                String           @id @default(uuid())
  reportCode        String           @unique
  treatmentPlantId  String
  reportDate        DateTime?
  reportMonth       MonthEnum?
  reportYear        Int?
  totalVolume       Decimal          @db.Decimal(12, 4)
  averageDailyFlow  Decimal?         @db.Decimal(10, 4)
  peakFlow          Decimal?         @db.Decimal(10, 4)
  minimumFlow       Decimal?         @db.Decimal(10, 4)
  initialFlow       Decimal          @db.Decimal(10, 4)
  finalFlow         Decimal          @db.Decimal(10, 4)
  reportDocumentUrl String?
  submittedBy       String
  submittedAt       DateTime
  receivedBy        String?
  receivedAt        DateTime?
  status            ReportStatusEnum @default(SUBMITTED)
  reviewedBy        String?
  reviewedAt        DateTime?
  reviewNotes       String?          @db.Text
  archivedAt        DateTime?
  isActive          Boolean          @default(true)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  // Relations
  treatmentPlant TreatmentPlant @relation(fields: [treatmentPlantId], references: [id])
  submitter      User           @relation("MonthlyFlowReportSubmitter", fields: [submittedBy], references: [id])
  receiver       User?          @relation("MonthlyFlowReportReceiver", fields: [receivedBy], references: [id])
  reviewer       User?          @relation("MonthlyFlowReportReviewer", fields: [reviewedBy], references: [id])

  @@unique([treatmentPlantId, reportMonth, reportYear])
  @@index([reportMonth, reportYear])
  @@index([status])
  @@index([receivedAt])
  @@map("t_monthly_flow_reports")
}

// Water Quality Lab Report - Transactional Data
model WaterQualityLabReport {
  id               String                            @id @default(uuid())
  reportCode       String                            @unique
  treatmentPlantId String
  category         WaterQualityLabReportCategoryEnum @default(WASTEWATER)
  reportDate       DateTime
  preparedBy       String
  summary          String?                           @db.Text
  recommendations  String?                           @db.Text
  analystSignature String?
  submittedBy      String
  submittedAt      DateTime
  receivedBy       String?
  receivedAt       DateTime?
  status           WaterQualityLabReportStatusEnum   @default(DRAFT)
  reviewedBy       String?
  reviewedAt       DateTime?
  reviewNotes      String?                           @db.Text
  archivedAt       DateTime?
  isActive         Boolean                           @default(true)
  createdAt        DateTime                          @default(now())
  updatedAt        DateTime                          @updatedAt

  // Relations
  treatmentPlant   TreatmentPlant                    @relation(fields: [treatmentPlantId], references: [id])
  preparer         User                              @relation("WaterQualityLabReportPreparer", fields: [preparedBy], references: [id])
  submitter        User                              @relation("WaterQualityLabReportSubmitter", fields: [submittedBy], references: [id])
  receiver         User?                             @relation("WaterQualityLabReportReceiver", fields: [receivedBy], references: [id])
  reviewer         User?                             @relation("WaterQualityLabReportReviewer", fields: [reviewedBy], references: [id])
  labReportResults WaterQualityLabReportResult[]
  attachments      WaterQualityLabReportAttachment[]

  @@index([treatmentPlantId, reportDate])
  @@index([reportDate])
  @@index([status])
  @@index([category])
  @@index([receivedAt])
  @@map("t_water_quality_lab_reports")
}

// Water Quality Lab Report Attachment - Transactional Data
model WaterQualityLabReportAttachment {
  id          String   @id @default(uuid())
  labReportId String
  fileUrl     String
  fileName    String?
  order       Int
  createdAt   DateTime @default(now())

  // Relations
  labReport WaterQualityLabReport @relation(fields: [labReportId], references: [id], onDelete: Cascade)

  @@index([labReportId])
  @@index([order])
  @@map("t_water_quality_lab_report_attachments")
}

// Water Quality Lab Report Result - Transactional Data (per-parameter result values)
model WaterQualityLabReportResult {
  id          String   @id @default(uuid())
  labReportId String
  parameterId String
  resultValue Decimal  @db.Decimal(12, 4)
  unit        String?
  isCompliant Boolean?
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  labReport WaterQualityLabReport @relation(fields: [labReportId], references: [id], onDelete: Cascade)
  parameter WaterQualityParameter @relation(fields: [parameterId], references: [id])

  @@unique([labReportId, parameterId])
  @@index([labReportId])
  @@index([parameterId])
  @@map("t_water_quality_lab_report_results")
}

// ============================================================
// SOLID WASTE MANAGEMENT - Master Data
// ============================================================

// Waste Type - Master Data
model WasteType {
  id                      String        @id @default(uuid())
  name                    String
  code                    String        @unique
  wasteType               WasteTypeEnum
  description             String?       @db.Text
  requiresSpecialHandling Boolean       @default(false)
  isActive                Boolean       @default(true)
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  // Relations
  weightReportItems WeightReportItem[]

  @@map("m_waste_types")
}

// Waste Source - Master Data
model WasteSource {
  id            String   @id @default(uuid())
  name          String
  code          String   @unique
  sourceType    String
  description   String?  @db.Text
  contactPerson String?
  phone         String?
  email         String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  weightReports WeightReport[]

  @@map("m_waste_sources")
}

// Storage Location - Master Data
model StorageLocation {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  location    String
  areaId      String?
  description String?  @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String

  // Relations
  area          Area?          @relation(fields: [areaId], references: [id])
  creator       User           @relation("StorageLocationCreator", fields: [createdBy], references: [id])
  weightReports WeightReport[]

  @@map("m_storage_locations")
}

// ============================================================
// SOLID WASTE MANAGEMENT - Transactional Data
// ============================================================

// Weight Report - Transactional Data
model WeightReport {
  id                String                 @id @default(uuid())
  reportCode        String                 @unique
  sourceId          String
  storageLocationId String
  reportDate        DateTime
  reportMonth       MonthEnum?
  reportYear        Int?
  reportDocumentUrl String?
  submittedBy       String
  submittedAt       DateTime
  receivedBy        String?
  receivedAt        DateTime?
  status            WeightReportStatusEnum @default(DRAFT)
  reviewedBy        String?
  reviewedAt        DateTime?
  reviewNotes       String?                @db.Text
  archivedAt        DateTime?
  isActive          Boolean                @default(true)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  // Relations
  source          WasteSource        @relation(fields: [sourceId], references: [id])
  storageLocation StorageLocation    @relation(fields: [storageLocationId], references: [id])
  submitter       User               @relation("WeightReportSubmitter", fields: [submittedBy], references: [id])
  receiver        User?              @relation("WeightReportReceiver", fields: [receivedBy], references: [id])
  reviewer        User?              @relation("WeightReportReviewer", fields: [reviewedBy], references: [id])
  items           WeightReportItem[]

  @@unique([sourceId, reportDate])
  @@index([reportMonth, reportYear])
  @@index([reportDate])
  @@index([status])
  @@index([receivedAt])
  @@map("t_weight_reports")
}

// Weight Report Item - Transactional Data
model WeightReportItem {
  id             String   @id @default(uuid())
  weightReportId String
  wasteTypeId    String
  weight         Decimal  @db.Decimal(10, 2)
  unit           String   @default("kg")
  order          Int
  notes          String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  weightReport WeightReport @relation(fields: [weightReportId], references: [id], onDelete: Cascade)
  wasteType    WasteType    @relation(fields: [wasteTypeId], references: [id])

  @@unique([weightReportId, wasteTypeId])
  @@map("t_weight_report_items")
}

// Dispatch Order - Transactional Data
model DispatchOrder {
  id           String            @id @default(uuid())
  dispatchCode String            @unique
  dispatchDate DateTime
  orderedBy    String
  quantity     Decimal           @db.Decimal(10, 2)
  memo         String?           @db.Text
  status       GeneralStatusEnum @default(WAITING_APPROVAL)
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  createdBy    String

  // Relations
  orderer     User                      @relation("DispatchOrderOrderer", fields: [orderedBy], references: [id])
  creator     User                      @relation("DispatchOrderCreator", fields: [createdBy], references: [id])
  attachments DispatchOrderAttachment[]

  @@index([dispatchDate])
  @@index([orderedBy])
  @@index([status])
  @@map("t_dispatch_orders")
}

// Dispatch Order Attachment - Transactional Data
model DispatchOrderAttachment {
  id              String   @id @default(uuid())
  dispatchOrderId String
  fileUrl         String
  fileName        String?
  order           Int
  createdAt       DateTime @default(now())

  // Relations
  dispatchOrder DispatchOrder @relation(fields: [dispatchOrderId], references: [id], onDelete: Cascade)

  @@index([dispatchOrderId])
  @@index([order])
  @@map("t_dispatch_order_attachments")
}

// ============================================================
// MAN HOUR MANAGEMENT
// ============================================================

// Man Hour - Transactional Data
model ManHour {
  id               String           @id @default(uuid())
  name             String
  group            ManHourGroupEnum
  qty              Int
  manHourPerDay    Decimal          @db.Decimal(4, 2)
  month            MonthEnum
  year             Int
  totalWorkingDays Decimal          @default(0) @db.Decimal(10, 2)
  lostHour         Decimal          @default(0) @db.Decimal(10, 2)
  total            Decimal          @db.Decimal(10, 2)
  notes            String?          @db.Text
  isActive         Boolean          @default(true)
  deletedAt        DateTime?
  deletedBy        String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  createdBy        String

  // Relations
  creator User @relation("ManHourCreator", fields: [createdBy], references: [id])

  @@index([month, year])
  @@index([group])
  @@map("t_man_hours")
}

// ============================================================
// KPI HSE TARGET
// ============================================================

// HSE Target - Transactional Data
// Targets for actual vs target comparison across modules (incident, risk, inspection, audit)
model HseTarget {
  id        String            @id @default(uuid())
  type      HseTargetTypeEnum
  code      String
  name      String?
  month     MonthEnum?
  year      Int
  target    Decimal           @db.Decimal(10, 2)
  isActive  Boolean           @default(true)
  deletedAt DateTime?
  deletedBy String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  createdBy String

  // Relations
  creator User @relation("HseTargetCreator", fields: [createdBy], references: [id])

  @@index([type, year])
  @@map("t_hse_targets")
}

// ============================================================
// INVESTIGATION REPORT MODULE
// 1-to-1 extension of Incident — see docs/investigation-report-prd.md
// ============================================================

enum InvestigationStatusEnum {
  DRAFT
  COMPLETE
}

enum InvestigationCauseSectionEnum {
  LATENT_FAILURE
  ACTIVE_FAILURE
}

enum InvestigationSignatoryRoleEnum {
  LEAD_INVESTIGATOR
  INVESTIGATOR_2
  INVESTIGATOR_3
  RELATED_MANAGER
  SECURITY
}

model InvestigationReport {
  id                 String                  @id @default(uuid())
  incidentId         String                  @unique
  reportNumber       String                  @unique
  taskBeingPerformed String?                 @db.Text
  equipmentUsed      String?                 @db.Text
  status             InvestigationStatusEnum @default(DRAFT)

  hsComments        String?   @db.Text
  hsCommentSignedBy String?
  hsCommentSignedAt DateTime?

  distributionSafetyCommittee   Boolean @default(false)
  distributionHeadOfBusinessOp  Boolean @default(false)
  distributionRelatedDepartment Boolean @default(false)

  bodyPartsSummary   String[]
  injuryTypesSummary String[]
  mechanismsSummary  String[]
  bodyDiagramUrl     String?  @db.Text

  isActive  Boolean  @default(true)
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  incident Incident @relation(fields: [incidentId], references: [id])
  creator  User     @relation("InvestigationReportCreator", fields: [createdBy], references: [id])
  hsSigner User?    @relation("InvestigationReportHsSigner", fields: [hsCommentSignedBy], references: [id])

  cost        InvestigationCost?
  causes      InvestigationCause[]
  actionPlans InvestigationActionPlan[]
  signatories InvestigationSignatory[]

  @@index([status])
  @@index([createdAt])
  @@index([isActive])
  @@map("t_investigation_reports")
}

model InvestigationCost {
  id                    String   @id @default(uuid())
  investigationReportId String   @unique
  currency              String   @default("IDR") @db.VarChar(3)
  medicalCost           Decimal? @db.Decimal(15, 2)
  lostTimeCost          Decimal? @db.Decimal(15, 2)
  damageCost            Decimal? @db.Decimal(15, 2)
  repairCost            Decimal? @db.Decimal(15, 2)
  compensationCost      Decimal? @db.Decimal(15, 2)
  otherCost             Decimal? @db.Decimal(15, 2)
  isNotYetKnown         Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  investigationReport InvestigationReport @relation(fields: [investigationReportId], references: [id], onDelete: Cascade)

  @@map("t_investigation_costs")
}

model InvestigationCause {
  id                    String                        @id @default(uuid())
  investigationReportId String
  section               InvestigationCauseSectionEnum
  tier1                 String                        @db.VarChar(64)
  tier2                 String                        @db.VarChar(64)
  causeKey              String                        @db.VarChar(16)
  causeName             String                        @db.VarChar(256)
  isSelected            Boolean                       @default(true)
  customNotes           String?                       @db.Text
  order                 Int                           @default(0)
  hfacsNodeId           String?
  createdAt             DateTime                      @default(now())
  updatedAt             DateTime                      @updatedAt

  investigationReport InvestigationReport @relation(fields: [investigationReportId], references: [id], onDelete: Cascade)
  hfacsNode           HfacsNode?          @relation(fields: [hfacsNodeId], references: [id], onDelete: SetNull)

  @@unique([investigationReportId, causeKey])
  @@index([investigationReportId])
  @@index([investigationReportId, section])
  @@index([isSelected])
  @@index([hfacsNodeId])
  @@map("t_investigation_causes")
}

model HfacsNode {
  id        String                        @id @default(uuid())
  parentId  String?
  section   InvestigationCauseSectionEnum
  depth     Int
  code      String?                       @db.VarChar(32)
  labelEn   String                        @db.VarChar(256)
  labelId   String                        @db.VarChar(256)
  isOther   Boolean                       @default(false)
  order     Int                           @default(0)
  isActive  Boolean                       @default(true)
  deletedAt DateTime?
  deletedBy String?
  createdAt DateTime                      @default(now())
  updatedAt DateTime                      @updatedAt

  parent              HfacsNode?           @relation("HfacsTree", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  children            HfacsNode[]          @relation("HfacsTree")
  investigationCauses InvestigationCause[]

  @@index([parentId, order])
  @@index([section, depth])
  @@index([code])
  @@map("m_hfacs_nodes")
}

model InvestigationActionPlan {
  id                    String    @id @default(uuid())
  investigationReportId String
  actionPlan            String    @db.Text
  responsiblePerson     String?   @db.VarChar(512)
  targetDate            DateTime?
  targetDateNotes       String?   @db.Text
  verificationDate      DateTime?
  verifiedBy            String?
  order                 Int
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  investigationReport InvestigationReport @relation(fields: [investigationReportId], references: [id], onDelete: Cascade)
  verifier            User?               @relation("InvestigationActionPlanVerifier", fields: [verifiedBy], references: [id])

  @@index([investigationReportId])
  @@index([investigationReportId, order])
  @@index([verifiedBy])
  @@index([targetDate])
  @@map("t_investigation_action_plans")
}

model InvestigationSignatory {
  id                    String                          @id @default(uuid())
  investigationReportId String
  signatoryRole         InvestigationSignatoryRoleEnum?
  roleName              String?                         @db.VarChar(128)
  name                  String?                         @db.VarChar(256)
  signedAt              DateTime?
  order                 Int                             @default(0)
  createdAt             DateTime                        @default(now())
  updatedAt             DateTime                        @updatedAt

  investigationReport InvestigationReport @relation(fields: [investigationReportId], references: [id], onDelete: Cascade)

  @@index([investigationReportId])
  @@map("t_investigation_signatories")
}
