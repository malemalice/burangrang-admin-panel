  waterQualityLabReports WaterQualityLabReport[]

  @@map("m_treatment_plants")
}

// Water Quality Parameter - Master Data
model WaterQualityParameter {
  id              String                            @id @default(uuid())
  name            String
  code            String                            @unique
  category        WaterQualityParameterCategoryEnum @default(CHEMISTRY)
  unit            String
  standardLimit   Decimal?                          @db.Decimal(10, 4)
  regulatoryLimit Decimal?                          @db.Decimal(10, 4)
  testMethod      String?
  description     String?                           @db.Text
  displayOrder    Int?
  isActive        Boolean                           @default(true)
  dateSampleTaken DateTime
  createdAt       DateTime                          @default(now())
  updatedAt       DateTime                          @updatedAt

