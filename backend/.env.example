# Database connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/office_nexus?schema=public"

# Application
PORT=3000
NODE_ENV=development

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRATION=3600 # 1 hour in seconds
JWT_REFRESH_EXPIRATION=604800 # 7 days in seconds

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173 

# Default Permissions
# Comma-separated list of permission IDs that must exist in every role
# Format: permission1,permission2,permission3
DEFAULT_PERMISSIONS=auth:change-password,auth:login,auth:logout,auth:refresh-token,auth:reset-password

APPROVAL_ENTITY={"RiskAssessment":"t_risk_assessment","Incident":"t_incident"}

# Zoho integration flags
ZOHO_SYNC_ENABLED=false
ZOHO_WEBHOOK_ENABLED=false

# Webhook auth modes: secret | jwt | signature
ZOHO_WEBHOOK_AUTH_MODE=secret
ZOHO_WEBHOOK_SECRET=your_webhook_secret_here
ZOHO_WEBHOOK_JWT=your_webhook_jwt_here

# ServiceDesk Plus outbound API (required for outbound sync)
SDP_BASE_URL=https://servicedesk.hapfor.com
SDP_AUTHTOKEN=your_sdp_authtoken
SDP_API_VERSION=v3

# Inbound defaults
ZOHO_DEFAULT_DEPARTMENT_ID=
ZOHO_INTEGRATION_USER_ID=
ZOHO_INBOUND_DEFAULT_STATUS=OPEN

# Outbound mapping + retry
ZOHO_STATUS_MAP={"DRAFT":"Open","OPEN":"On Hold","WAITING_APPROVAL":"On Hold","DONE":"Closed","CLOSE":"Closed","REJECTED":"Open"}
ZOHO_MAX_RETRIES=6
ZOHO_RETRY_BASE_MS=2000
ZOHO_RETRY_MAX_MS=60000
ZOHO_WORKER_BATCH_SIZE=5