# Database connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/office_nexus?schema=public"

# Application
PORT=3000
NODE_ENV=development

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRATION=3600 # 1 hour in seconds
JWT_REFRESH_EXPIRATION=604800 # 7 days in seconds

# Session (for OAuth 2.0 + PKCE)
SESSION_SECRET=your_session_secret_here

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Frontend URL
FRONTEND_URL=http://localhost:5173

# CORS Configuration - Multiple Frontend Domains
# Comma-separated list of allowed origins for CORS
# Development: Multiple local frontend applications
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://localhost:3001"

# Production Example:
# CORS_ORIGINS="https://admin.soulyousee.com,https://app.soulyousee.com,https://soulyousee.com"

# Legacy: Single frontend URL (deprecated, use CORS_ORIGINS instead)
# FRONTEND_URL=http://localhost:5173

# Default Permissions
# Comma-separated list of permission IDs that must exist in every role
# Format: permission1,permission2,permission3
DEFAULT_PERMISSIONS=auth:change-password,auth:login,auth:logout,auth:refresh-token,auth:reset-password

# Media/File Upload — paths and URLs come from env (not m_file_storage_providers).
# Seed sets which provider is default: DEFAULT_STORAGE_PROVIDER=local | aws-s3
DEFAULT_STORAGE_PROVIDER=local
UPLOAD_DIR="./uploads"
PUBLIC_URL="http://localhost:3000"
# Optional: override base URL for API download links only (e.g. CDN). Defaults to PUBLIC_URL.
# MEDIA_URL="https://cdn.example.com"

# S3-compatible object storage (AWS S3, Cloudflare R2, MinIO). Required when default provider is aws-s3.
# Alternate names also supported: S3_BUCKET, S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY, S3_REGION, AWS_S3_ENDPOINT.
# Region: omit AWS_REGION / S3_REGION to default to us-east-1 in code. Set explicitly for non-us-east-1 AWS buckets, or S3_REGION=auto for Cloudflare R2.
AWS_S3_BUCKET=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""
S3_FORCE_PATH_STYLE="false"
S3_PUBLIC_BASE_URL=""

# Xendit Payment Gateway Configuration
# Get your API keys from Xendit Dashboard: https://dashboard.xendit.co/settings/developers
XENDIT_SECRET_KEY=xnd_development_... # Use xnd_development for sandbox, xnd_production for live
XENDIT_WEBHOOK_TOKEN=your_webhook_verification_token_here # Set this in Xendit Dashboard webhook settings
XENDIT_ENVIRONMENT=sandbox # sandbox or production
XENDIT_SUCCESS_URL=http://localhost:5173/payment/success # Frontend URL for successful payment
XENDIT_FAILURE_URL=http://localhost:5173/payment/failed # Frontend URL for failed payment
